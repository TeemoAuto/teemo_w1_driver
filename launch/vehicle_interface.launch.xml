<?xml version="1.0"?>
<launch>
  <arg name="interface" default="can0"/>
  <arg name="max_speed" default="5.0"/>

  <!-- 启动您写好的那个 Python Launch 文件 -->
  <include file="$(find-pkg-share teemo_vehicle_interface)/launch/vehicle_interface.launch.py">
    <arg name="interface" value="$(var interface)"/>
    <arg name="max_speed" value="$(var max_speed)"/>
  </include>
</launch>
